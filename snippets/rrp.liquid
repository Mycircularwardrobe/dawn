{% comment %}
  Renders the recommended retail price (RRP) next to the product's selling price,
  with the percentage saving. Renders nothing when the product has no
  `custom.rrp` value, or when the RRP is not higher than the current price.

  Accepts:
  - product: {Object} Product Liquid object (required)
  - compact: {Boolean} Tighter styling, for use on product cards (optional)

  Metafields used:
  - custom.rrp            (type: money) — .value is an amount in cents, like product.price
  - custom.rrp_estimated  (type: true/false, optional) — when true the label reads
                          "Est. RRP" (used for guessed or currency-converted figures);
                          otherwise it reads "RRP".

  Usage:
  {% render 'rrp', product: product %}
  {% render 'rrp', product: card_product, compact: true %}
{% endcomment %}

{%- liquid
  assign rrp_mf = product.metafields.custom.rrp
  assign rrp_pounds = rrp_mf.value | divided_by: 100.0
  assign price_pounds = product.price | divided_by: 100.0

  assign saving_pct = 0
  if rrp_pounds > price_pounds
    assign saving_pct = rrp_pounds | minus: price_pounds | times: 100.0 | divided_by: rrp_pounds | round
  endif

  assign rrp_label = 'RRP'
  if product.metafields.custom.rrp_estimated.value
    assign rrp_label = 'Est. RRP'
  endif
-%}

{%- if rrp_mf != blank and rrp_pounds > price_pounds -%}
  <div class="rrp{% if compact %} rrp--compact{% endif %}">
    <span class="rrp__label">{{ rrp_label }}</span>
    <s class="rrp__price">{{ rrp_mf.value | money }}</s>
    {%- if saving_pct >= 5 -%}
      <span class="rrp__saving">Save {{ saving_pct }}%</span>
    {%- endif -%}
  </div>
{%- endif -%}
