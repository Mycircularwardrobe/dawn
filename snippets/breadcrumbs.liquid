{%- comment -%}
  Breadcrumb trail + BreadcrumbList structured data.
  Renders on collection and product pages only. Added for SEO, Aug 2026.
  Rendered from layout/theme.liquid just inside <main>.
{%- endcomment -%}

{%- liquid
  assign show_breadcrumbs = false
  if request.page_type == 'collection' and collection.handle
    assign show_breadcrumbs = true
  endif
  if request.page_type == 'product'
    assign show_breadcrumbs = true
  endif

  assign home_url = request.origin | append: routes.root_url
-%}

{%- if show_breadcrumbs -%}
  {%- liquid
    # Work out the parent collection for a product page.
    assign crumb_collection = false
    if request.page_type == 'product'
      if collection.url
        assign crumb_collection = collection
      else
        for c in product.collections
          if c.handle == 'all' or c.handle == 'frontpage' or c.handle == 'new-in'
            continue
          endif
          assign crumb_collection = c
          break
        endfor
      endif
    endif
  -%}

  <nav class="breadcrumbs page-width" aria-label="Breadcrumb">
    <ol class="breadcrumbs__list" role="list">
      <li class="breadcrumbs__item">
        <a href="{{ routes.root_url }}">Home</a>
      </li>

      {%- if request.page_type == 'collection' -%}
        <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
          {{- collection.title | escape -}}
        </li>
      {%- elsif request.page_type == 'product' -%}
        {%- if crumb_collection -%}
          <li class="breadcrumbs__item">
            <a href="{{ crumb_collection.url }}">{{ crumb_collection.title | escape }}</a>
          </li>
        {%- endif -%}
        <li class="breadcrumbs__item breadcrumbs__item--current" aria-current="page">
          {{- product.title | escape -}}
        </li>
      {%- endif -%}
    </ol>
  </nav>

  {%- capture breadcrumb_json -%}
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ home_url | json }}
        }
        {%- if request.page_type == 'collection' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": {{ request.origin | append: collection.url | json }}
          }
        {%- elsif request.page_type == 'product' -%}
          {%- assign product_position = 2 -%}
          {%- if crumb_collection -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ crumb_collection.title | json }},
              "item": {{ request.origin | append: crumb_collection.url | json }}
            }
            {%- assign product_position = 3 -%}
          {%- endif -%}
          ,{
            "@type": "ListItem",
            "position": {{ product_position }},
            "name": {{ product.title | json }},
            "item": {{ request.origin | append: product.url | json }}
          }
        {%- endif -%}
      ]
    }
  {%- endcapture -%}
  <script type="application/ld+json">{{ breadcrumb_json }}</script>

  {%- style -%}
    .breadcrumbs {
      margin-top: 1.5rem;
      margin-bottom: 0.5rem;
      font-size: 1.3rem;
      line-height: 1.4;
    }
    .breadcrumbs__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.4rem 0.6rem;
    }
    .breadcrumbs__item {
      color: rgba(var(--color-foreground), 0.7);
      display: flex;
      align-items: center;
      gap: 0.4rem 0.6rem;
    }
    .breadcrumbs__item:not(:first-child)::before {
      content: "/";
      color: rgba(var(--color-foreground), 0.4);
    }
    .breadcrumbs__item a {
      color: inherit;
      text-decoration: none;
    }
    .breadcrumbs__item a:hover {
      text-decoration: underline;
    }
    .breadcrumbs__item--current {
      color: rgb(var(--color-foreground));
    }
  {%- endstyle -%}
{%- endif -%}
