          "type": "heading",
          "settings": {
            "heading": "<strong>Every Piece Checked.</strong>",
            "heading_size": "h2"
          }
        },
        "text_HV4wAH": {
          "type": "text",
          "settings": {
            "text": "<p>Every item that comes through My Circular Wardrobe is inspected in-house before it's listed. We check hardware, stitching and serial numbers to make sure what you're buying is exactly what it says it is. Thinking of selling with us instead? Our full vetting process is on our Sell With Us page.</p><p></p><p>​</p>",
            "text_style": "body"
          }
        }
